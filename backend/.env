# SQLite for zero-config setup
DATABASE_URL=sqlite+aiosqlite:///./skill_navigator.db

# JWT
JWT_SECRET=skill_navigator_super_secret_jwt_key_2024
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth — get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# ── LLM (optional) ────────────────────────────────────────────────────────────
# Enables frontier-model AI across mentor chat, gap analysis, roadmaps,
# assessments and dashboard insights. Works with any OpenAI-compatible
# provider: OpenAI, Groq, Together, DeepSeek, OpenRouter, Google Gemini
# (OpenAI-compat), or a local Ollama / LM Studio server.
# Leave LLM_API_KEY empty → the built-in offline engine is used instead
# (the app fully works with zero configuration).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.7
# LLM_ENABLED=1   # uncomment to force-enable a keyless local server (Ollama)
#
# ── FREE full-brain option (Google Gemini, generous free tier) ────────────────
# 1. Get a free key at https://aistudio.google.com/apikey
# 2. Comment out the 3 lines above and use these 3 instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=paste-your-gemini-key-here
# LLM_MODEL=gemini-2.0-flash

